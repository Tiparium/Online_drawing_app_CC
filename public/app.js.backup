// Initialize Fabric.js canvas
const canvas = new fabric.Canvas('canvas', {
    width: 800,
    height: 600,
    backgroundColor: '#ffffff'
});

let currentMode = 'draw';

// Tool buttons
const drawBtn = document.getElementById('drawBtn');
const selectBtn = document.getElementById('selectBtn');
const rectBtn = document.getElementById('rectBtn');
const circleBtn = document.getElementById('circleBtn');
const textBtn = document.getElementById('textBtn');
const clearBtn = document.getElementById('clearBtn');
const colorPicker = document.getElementById('colorPicker');
const brushSize = document.getElementById('brushSize');
const brushSizeValue = document.getElementById('brushSizeValue');
const smoothingSlider = document.getElementById('smoothingSlider');
const smoothingValue = document.getElementById('smoothingValue');
const saveBtn = document.getElementById('saveBtn');
const loadBtn = document.getElementById('loadBtn');
const fileInput = document.getElementById('fileInput');

// Smoothing implementation
let smoothingLevel = 0;

// Custom smoothed brush implementation with momentum-based physics
class SmoothedBrush extends fabric.PencilBrush {
    constructor(canvas) {
        super(canvas);
        this.smoothingLevel = 0;
        this._isDrawing = false;
        this._tempPath = null;
        this._animationFrame = null;
        this._lastFrameTime = null;
        
        // Cursor tracking - store recent cursor positions for path following
        this.cursorPath = []; // Recent cursor positions (for path following)
        this.cursorPos = null;
        this.prevCursorPos = null;
        this.prevCursorTime = null;
        
        // Physics state for drawing position
        this.drawPos = null; // Current drawing position
        this.drawVel = { x: 0, y: 0 }; // Current velocity (momentum)
        
        // Drawing points
        this.drawnPoints = []; // Points actually drawn (from drawPos)
        
        // Animation loop
        this.animate = this.animate.bind(this);
    }

    setSmoothingLevel(level) {
        this.smoothingLevel = level;
    }

    onMouseDown(pointer, options) {
        // Clean up any leftover temporary path
        if (this._tempPath) {
            this.canvas.remove(this._tempPath);
            this._tempPath = null;
        }
        
        // Initialize physics state
        this.cursorPos = { x: pointer.x, y: pointer.y };
        this.prevCursorPos = { x: pointer.x, y: pointer.y };
        this.prevCursorTime = Date.now();
        this._lastFrameTime = this.prevCursorTime;
        
        // Initialize drawing position and velocity
        this.drawPos = { x: pointer.x, y: pointer.y };
        this.drawVel = { x: 0, y: 0 };
        
        // Initialize cursor path tracking
        this.cursorPath = [{ x: pointer.x, y: pointer.y, time: this.prevCursorTime }];
        
        // Start drawing
        this.drawnPoints = [{ x: pointer.x, y: pointer.y }];
        this._isDrawing = true;
        
        // Start animation loop
        if (this._animationFrame) {
            cancelAnimationFrame(this._animationFrame);
        }
        this._lastFrameTime = performance.now();
        this.animate();
    }

    onMouseMove(pointer, options) {
        if (!this._isDrawing) return;
        
        const now = Date.now();
        
        // Update cursor position
        this.prevCursorPos = { ...this.cursorPos };
        this.cursorPos = { x: pointer.x, y: pointer.y };
        this.prevCursorTime = now;
        
        // Track cursor path (keep last 20 points for path following)
        this.cursorPath.push({ x: pointer.x, y: pointer.y, time: now });
        if (this.cursorPath.length > 20) {
            this.cursorPath.shift();
        }
    }

    onMouseUp(options) {
        if (!this._isDrawing) return;
        
        this._isDrawing = false;
        
        // Stop animation
        if (this._animationFrame) {
            cancelAnimationFrame(this._animationFrame);
            this._animationFrame = null;
        }
        
        // Finalize drawing - use momentum to catch up to cursor
        if (this.smoothingLevel === 0) {
            // No smoothing - just draw directly to cursor
            if (this.drawnPoints.length > 1) {
                this.finalizePath(this.drawnPoints, false);
            }
        } else {
            // With smoothing - use momentum to catch up
            if (this.drawnPoints.length > 1) {
                this.momentumCatchUp();
            } else if (this.drawnPoints.length > 0 && this.cursorPos) {
                // If we only have one point, add cursor position and finalize
                this.drawnPoints.push({ ...this.cursorPos });
                this.finalizePath(this.drawnPoints, true);
            }
        }
        
        // Reset after a short delay to allow catch-up to complete
        setTimeout(() => {
            this.drawnPoints = [];
            this.cursorPath = [];
            this.cursorPos = null;
            this.drawPos = null;
            this.drawVel = { x: 0, y: 0 };
        }, 200);
    }

    animate() {
        if (!this._isDrawing) return;
        
        const currentTime = performance.now();
        const deltaTime = Math.max(0.001, (currentTime - this._lastFrameTime) / 1000); // Convert to seconds
        this._lastFrameTime = currentTime;
        
        if (this.smoothingLevel === 0) {
            // No smoothing - draw directly at cursor position
            if (this.cursorPos) {
                const lastPoint = this.drawnPoints[this.drawnPoints.length - 1];
                const distance = Math.sqrt(
                    Math.pow(this.cursorPos.x - lastPoint.x, 2) +
                    Math.pow(this.cursorPos.y - lastPoint.y, 2)
                );
                
                if (distance > 1) { // Only add if moved significantly
                    this.drawnPoints.push({ ...this.cursorPos });
                    this.updatePath();
                }
            }
        } else {
            // With smoothing - use physics to update drawing position
            this.updatePhysics(deltaTime);
            
            // Add point if drawing position moved significantly
            const lastPoint = this.drawnPoints[this.drawnPoints.length - 1];
            const distance = Math.sqrt(
                Math.pow(this.drawPos.x - lastPoint.x, 2) +
                Math.pow(this.drawPos.y - lastPoint.y, 2)
            );
            
            if (distance > 0.5) { // Threshold for adding points
                this.drawnPoints.push({ ...this.drawPos });
                this.updatePath();
            }
        }
        
        // Continue animation
        this._animationFrame = requestAnimationFrame(this.animate);
    }

    updatePhysics(deltaTime) {
        if (!this.cursorPos || !this.drawPos) return;
        
        const smoothingFactor = this.smoothingLevel / 100; // 0 to 1
        
        // Check if cursor is stationary (hasn't moved recently)
        const now = Date.now();
        const timeSinceLastCursorMove = now - this.prevCursorTime;
        const isCursorStationary = timeSinceLastCursorMove > 50; // Cursor hasn't moved in 50ms
        
        // Calculate target position
        // If cursor is stationary, always target exactly the cursor position
        // Otherwise, use path following for smoother motion
        let targetPos = this.cursorPos;
        if (!isCursorStationary && this.cursorPath.length > 1 && smoothingFactor > 0) {
            // Look back in cursor path based on smoothing level
            // Higher smoothing = look further back (more lag)
            const lookBackIndex = Math.floor(this.cursorPath.length * smoothingFactor * 0.5);
            const targetIndex = Math.max(0, this.cursorPath.length - 1 - lookBackIndex);
            targetPos = {
                x: this.cursorPath[targetIndex].x,
                y: this.cursorPath[targetIndex].y
            };
        }
        
        // Calculate distance to target
        const dx = targetPos.x - this.drawPos.x;
        const dy = targetPos.y - this.drawPos.y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        
        // Current speed
        const currentSpeed = Math.sqrt(this.drawVel.x * this.drawVel.x + this.drawVel.y * this.drawVel.y);
        
        // Calculate braking distance - how far we'd travel with current velocity
        const brakingDistance = (currentSpeed * currentSpeed) / (2 * 200); // Assuming max deceleration
        
        // Calculate acceleration toward target
        // Higher smoothing = slower acceleration (more momentum, less responsive)
        const maxAcceleration = (1 - smoothingFactor) * 2000 + smoothingFactor * 200; // 200 to 2000 pixels/s²
        const maxDeceleration = maxAcceleration * 1.5; // Can brake faster than accelerate
        
        // Determine desired speed based on distance and braking
        let targetSpeed = 0;
        if (distance > 0.01) {
            if (distance < brakingDistance && currentSpeed > 0) {
                // Need to brake - reduce target speed based on distance
                const brakeFactor = Math.min(1, distance / brakingDistance);
                targetSpeed = currentSpeed * brakeFactor * 0.5; // Reduce speed when close
            } else {
                // Normal approach
                targetSpeed = Math.min(distance * 10, 500);
            }
        }
        
        // If cursor is stationary and we're very close, aggressively brake
        if (isCursorStationary && distance < 5) {
            targetSpeed = 0;
        }
        
        // Desired velocity direction
        let desiredVelX = 0;
        let desiredVelY = 0;
        if (distance > 0.01) {
            desiredVelX = (dx / distance) * targetSpeed;
            desiredVelY = (dy / distance) * targetSpeed;
        }
        
        // Calculate acceleration needed to reach desired velocity
        const accelX = desiredVelX - this.drawVel.x;
        const accelY = desiredVelY - this.drawVel.y;
        const accelMagnitude = Math.sqrt(accelX * accelX + accelY * accelY);
        
        // Use deceleration when braking (approaching target)
        const isBraking = distance < brakingDistance || (isCursorStationary && distance < 10);
        const maxAccel = isBraking ? maxDeceleration : maxAcceleration;
        
        // Limit acceleration based on smoothing
        let limitedAccelX = accelX;
        let limitedAccelY = accelY;
        if (accelMagnitude > maxAccel * deltaTime) {
            const scale = (maxAccel * deltaTime) / accelMagnitude;
            limitedAccelX = accelX * scale;
            limitedAccelY = accelY * scale;
        }
        
        // Apply acceleration to velocity
        this.drawVel.x += limitedAccelX;
        this.drawVel.y += limitedAccelY;
        
        // Apply damping/friction (more aggressive when close to target or stationary)
        let damping = 0.95 + smoothingFactor * 0.04; // 0.95 to 0.99
        if (isCursorStationary && distance < 10) {
            damping = 0.85; // More aggressive damping when cursor is stationary and close
        } else if (distance < 5) {
            damping = 0.90; // Slightly more damping when very close
        }
        this.drawVel.x *= damping;
        this.drawVel.y *= damping;
        
        // Update position based on velocity
        this.drawPos.x += this.drawVel.x * deltaTime;
        this.drawPos.y += this.drawVel.y * deltaTime;
        
        // If cursor is stationary and we're very close, snap to exact position
        if (isCursorStationary && distance < 0.5 && currentSpeed < 5) {
            this.drawPos.x = targetPos.x;
            this.drawPos.y = targetPos.y;
            this.drawVel.x = 0;
            this.drawVel.y = 0;
        }
    }

    momentumCatchUp() {
        // Use momentum physics to catch up to cursor when mouse is released
        const smoothingFactor = this.smoothingLevel / 100;
        const maxIterations = Math.max(120, Math.floor(240 * smoothingFactor)); // More iterations for high smoothing
        let iteration = 0;
        const finalPoints = [...this.drawnPoints]; // Copy current points
        let lastTime = performance.now();
        
        const catchUp = () => {
            if (!this.drawPos || !this.cursorPos || iteration >= maxIterations) {
                // Finalize with what we have
                if (finalPoints.length > 1) {
                    this.finalizePath(finalPoints, this.smoothingLevel > 0);
                }
                return;
            }
            
            const currentTime = performance.now();
            const deltaTime = Math.max(0.001, (currentTime - lastTime) / 1000);
            lastTime = currentTime;
            
            // Continue physics simulation
            this.updatePhysics(deltaTime);
            
            // Check if we're close enough
            const dx = this.cursorPos.x - this.drawPos.x;
            const dy = this.cursorPos.y - this.drawPos.y;
            const distance = Math.sqrt(dx * dx + dy * dy);
            
            if (distance < 0.5 && Math.abs(this.drawVel.x) < 5 && Math.abs(this.drawVel.y) < 5) {
                // Close enough and slow enough - finalize
                if (distance >= 0.5) {
                    finalPoints.push({ ...this.cursorPos });
                }
                if (finalPoints.length > 1) {
                    this.finalizePath(finalPoints, this.smoothingLevel > 0);
                }
                return;
            }
            
            // Add point to final path
            const lastPoint = finalPoints[finalPoints.length - 1];
            const pointDistance = Math.sqrt(
                Math.pow(this.drawPos.x - lastPoint.x, 2) +
                Math.pow(this.drawPos.y - lastPoint.y, 2)
            );
            
            if (pointDistance > 0.5) {
                finalPoints.push({ ...this.drawPos });
            }
            
            // Update temporary path to show catch-up animation
            if (this._tempPath) {
                this.canvas.remove(this._tempPath);
            }
            if (finalPoints.length > 1) {
                const pointsToDraw = this.smoothingLevel > 0 && finalPoints.length > 2 
                    ? this.smoothPath(finalPoints) 
                    : finalPoints;
                const pathData = this.createPathFromPoints(pointsToDraw, this.smoothingLevel > 0);
                this._tempPath = new fabric.Path(pathData, {
                    fill: '',
                    stroke: this.color,
                    strokeWidth: this.width,
                    strokeLineCap: 'round',
                    strokeLineJoin: 'round',
                    selectable: false,
                    evented: false
                });
                this.canvas.add(this._tempPath);
                this.canvas.renderAll();
            }
            
            iteration++;
            requestAnimationFrame(catchUp);
        };
        
        catchUp();
    }

    updatePath() {
        if (this.drawnPoints.length < 2) return;
        
        // Remove old temporary path
        if (this._tempPath) {
            this.canvas.remove(this._tempPath);
            this._tempPath = null;
        }
        
        // Apply path smoothing to drawn points
        let pointsToDraw = this.drawnPoints;
        if (this.smoothingLevel > 0 && this.drawnPoints.length > 2) {
            pointsToDraw = this.smoothPath(this.drawnPoints);
        }
        
        // Create path
        const pathData = this.createPathFromPoints(pointsToDraw, this.smoothingLevel > 0);
        this._tempPath = new fabric.Path(pathData, {
            fill: '',
            stroke: this.color,
            strokeWidth: this.width,
            strokeLineCap: 'round',
            strokeLineJoin: 'round',
            selectable: false,
            evented: false
        });
        
        this.canvas.add(this._tempPath);
        this.canvas.renderAll();
    }

    finalizePath(points, useCurves) {
        // Remove temporary path
        if (this._tempPath) {
            this.canvas.remove(this._tempPath);
            this._tempPath = null;
        }
        
        if (points.length < 2) return;
        
        // Apply smoothing if needed
        let pointsToDraw = points;
        if (useCurves && points.length > 2) {
            pointsToDraw = this.smoothPath(points);
        }
        
        // Create final path
        const pathData = this.createPathFromPoints(pointsToDraw, useCurves);
        const finalPath = new fabric.Path(pathData, {
            fill: '',
            stroke: this.color,
            strokeWidth: this.width,
            strokeLineCap: 'round',
            strokeLineJoin: 'round',
            selectable: false,
            evented: false
        });
        
        this.canvas.add(finalPath);
        this.canvas.renderAll();
    }

    smoothPath(points) {
        if (points.length < 3) return points;
        
        const smoothingFactor = this.smoothingLevel / 100;
        // More aggressive smoothing with larger window
        const windowSize = Math.max(1, Math.floor(smoothingFactor * 10) + 1); // 1 to 11 points
        
        // Apply multiple passes of smoothing for more aggressive effect
        let smoothed = [...points];
        const passes = Math.max(1, Math.floor(smoothingFactor * 3) + 1); // 1 to 4 passes
        
        for (let pass = 0; pass < passes; pass++) {
            const newSmoothed = [smoothed[0]]; // Keep first point
            
            for (let i = 1; i < smoothed.length - 1; i++) {
                // Use larger window for averaging
                const start = Math.max(0, i - windowSize);
                const end = Math.min(smoothed.length - 1, i + windowSize);
                
                let sumX = 0;
                let sumY = 0;
                let count = 0;
                
                // Weighted average with more weight to center
                for (let j = start; j <= end; j++) {
                    const distance = Math.abs(j - i);
                    const weight = 1 / (1 + distance * smoothingFactor * 3);
                    sumX += smoothed[j].x * weight;
                    sumY += smoothed[j].y * weight;
                    count += weight;
                }
                
                newSmoothed.push({
                    x: sumX / count,
                    y: sumY / count
                });
            }
            
            newSmoothed.push(smoothed[smoothed.length - 1]); // Keep last point
            smoothed = newSmoothed;
        }
        
        return smoothed;
    }

    createPathFromPoints(points, useCurves = true) {
        if (points.length < 2) return '';
        
        let path = `M ${points[0].x} ${points[0].y}`;
        
        if (useCurves && points.length > 2) {
            // Use quadratic curves for smooth lines
            for (let i = 1; i < points.length - 1; i++) {
                const midX = (points[i].x + points[i + 1].x) / 2;
                const midY = (points[i].y + points[i + 1].y) / 2;
                path += ` Q ${points[i].x} ${points[i].y} ${midX} ${midY}`;
            }
            path += ` L ${points[points.length - 1].x} ${points[points.length - 1].y}`;
        } else {
            // Use straight line segments
            for (let i = 1; i < points.length; i++) {
                path += ` L ${points[i].x} ${points[i].y}`;
            }
        }
        
        return path;
    }
}

// Create smoothed brush instance
const smoothedBrush = new SmoothedBrush(canvas);

// Tool selection
function setMode(mode) {
    currentMode = mode;
    canvas.isDrawingMode = (mode === 'draw');
    canvas.selection = (mode === 'select');
    
    // Update button states
    [drawBtn, selectBtn, rectBtn, circleBtn, textBtn].forEach(btn => {
        btn.classList.remove('active');
    });
    
    if (mode === 'draw') drawBtn.classList.add('active');
    if (mode === 'select') selectBtn.classList.add('active');
    if (mode === 'rect') rectBtn.classList.add('active');
    if (mode === 'circle') circleBtn.classList.add('active');
    if (mode === 'text') textBtn.classList.add('active');
}

drawBtn.addEventListener('click', () => setMode('draw'));
selectBtn.addEventListener('click', () => setMode('select'));
rectBtn.addEventListener('click', () => setMode('rect'));
circleBtn.addEventListener('click', () => setMode('circle'));
textBtn.addEventListener('click', () => setMode('text'));

// Configure drawing mode
canvas.freeDrawingBrush = smoothedBrush;
canvas.freeDrawingBrush.width = parseInt(brushSize.value);
canvas.freeDrawingBrush.color = colorPicker.value;

// Update brush size display and apply to brush
brushSize.addEventListener('input', (e) => {
    const size = parseInt(e.target.value);
    brushSizeValue.textContent = size;
    canvas.freeDrawingBrush.width = size;
    smoothedBrush.width = size;
});

// Update color and apply to brush
colorPicker.addEventListener('input', (e) => {
    const color = e.target.value;
    canvas.freeDrawingBrush.color = color;
    smoothedBrush.color = color;
});

// Update smoothing level and apply to brush
smoothingSlider.addEventListener('input', (e) => {
    smoothingLevel = parseInt(e.target.value);
    smoothingValue.textContent = smoothingLevel;
    smoothedBrush.setSmoothingLevel(smoothingLevel);
});

// Rectangle tool
rectBtn.addEventListener('click', () => {
    setMode('rect');
    canvas.on('mouse:down', startRect);
});

function startRect(o) {
    if (currentMode !== 'rect') return;
    
    const pointer = canvas.getPointer(o.e);
    const rect = new fabric.Rect({
        left: pointer.x,
        top: pointer.y,
        width: 0,
        height: 0,
        fill: 'transparent',
        stroke: colorPicker.value,
        strokeWidth: parseInt(brushSize.value)
    });
    
    canvas.add(rect);
    canvas.setActiveObject(rect);
    
    canvas.on('mouse:move', (o) => {
        const pointer = canvas.getPointer(o.e);
        rect.set({
            width: Math.abs(pointer.x - rect.left),
            height: Math.abs(pointer.y - rect.top)
        });
        canvas.renderAll();
    });
    
    canvas.once('mouse:up', () => {
        canvas.off('mouse:move');
        canvas.off('mouse:down', startRect);
    });
}

// Circle tool
circleBtn.addEventListener('click', () => {
    setMode('circle');
    canvas.on('mouse:down', startCircle);
});

function startCircle(o) {
    if (currentMode !== 'circle') return;
    
    const pointer = canvas.getPointer(o.e);
    const circle = new fabric.Circle({
        left: pointer.x,
        top: pointer.y,
        radius: 0,
        fill: 'transparent',
        stroke: colorPicker.value,
        strokeWidth: parseInt(brushSize.value)
    });
    
    canvas.add(circle);
    canvas.setActiveObject(circle);
    
    canvas.on('mouse:move', (o) => {
        const pointer = canvas.getPointer(o.e);
        const radius = Math.sqrt(
            Math.pow(pointer.x - circle.left, 2) + 
            Math.pow(pointer.y - circle.top, 2)
        );
        circle.set({ radius });
        canvas.renderAll();
    });
    
    canvas.once('mouse:up', () => {
        canvas.off('mouse:move');
        canvas.off('mouse:down', startCircle);
    });
}

// Text tool
textBtn.addEventListener('click', () => {
    setMode('text');
    const text = new fabric.IText('Click to edit', {
        left: 400,
        top: 300,
        fontFamily: 'Arial',
        fontSize: 20,
        fill: colorPicker.value
    });
    canvas.add(text);
    canvas.setActiveObject(text);
    canvas.renderAll();
});

// Clear canvas
clearBtn.addEventListener('click', () => {
    if (confirm('Are you sure you want to clear the canvas?')) {
        canvas.clear();
        canvas.backgroundColor = '#ffffff';
        canvas.renderAll();
    }
});

// Save canvas as image
saveBtn.addEventListener('click', () => {
    const dataURL = canvas.toDataURL({
        format: 'png',
        quality: 1.0
    });
    
    const link = document.createElement('a');
    link.download = 'drawing.png';
    link.href = dataURL;
    link.click();
});

// Load image
loadBtn.addEventListener('click', () => {
    fileInput.click();
});

fileInput.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (file) {
        const reader = new FileReader();
        reader.onload = (event) => {
            const img = new Image();
            img.onload = () => {
                fabric.Image.fromURL(event.target.result, (img) => {
                    canvas.add(img);
                    canvas.renderAll();
                });
            };
            img.src = event.target.result;
        };
        reader.readAsDataURL(file);
    }
});

// Initialize with draw mode
setMode('draw');

